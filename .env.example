# Copy this file to .env for local development.
# Never commit real secrets to Git.

APP_ENV=development
APP_NAME=BIRAJ AI
DATABASE_URL=sqlite:///./biraj_ai.db
# Set a long random value before enabling tenant provisioning.
BIRAJ_ADMIN_KEY=

# Cloudflare Workers AI is the only approved runtime provider.
# Keep inference disabled until the account plan, token permissions and quota
# are verified. Use a Workers Free account to avoid paid usage.
BIRAJ_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Multilingual chat model; verify current account/model availability before enabling.
BIRAJ_AI_MODEL=@cf/zai-org/glm-4.7-flash
BIRAJ_AI_MAX_OUTPUT_TOKENS=512

# Optional Redis-backed tenant rate limiter.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
