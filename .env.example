# Copy this file to .env for local development.
# Never commit real secrets to Git.

APP_ENV=development
APP_NAME=BIRAJ AI
DATABASE_URL=sqlite:///./biraj_ai.db
# Set a long random value before enabling tenant provisioning.
BIRAJ_ADMIN_KEY=
# Optional Redis-backed tenant rate limiter.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Self-hosted open-weight model runtime. No OpenAI/Gemini API is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
BIRAJ_AI_MODEL=qwen2.5:0.5b
